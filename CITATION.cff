    affiliation: >-
      Division of Cardiology, Lahey Hospital and Medical Center,
      Beth Israel Lahey Health, Burlington, Massachusetts, USA
license: MIT
# Tagged for the JAMA Cardiology submission. The DOI stays commented out
# below until Zenodo mints one, which happens when the release is cut with
# the repository connected to Zenodo -- filling it in beforehand would
# promise a resolver that does not yet resolve.
version: "1.0.0"
date-released: "2026-09-18"
keywords:
  - apolipoprotein B
  - dyslipidemia
  - clinical practice guidelines
  - guideline implementation
  - NHANES
  - complex survey analysis
  - cardiovascular disease prevention
  - reproducible research

# ---------------------------------------------------------------------------
# TO COMPLETE BEFORE, OR JUST AFTER, THE FIRST PUSH
#
#   version and date-released: SET ABOVE for the submission tag. Bump
#     version and date-released together if the submitted code changes.
#     Cutting a release is also what triggers Zenodo to mint the DOI the
#     manuscript's Data Sharing Statement promises.
#
#   doi: the Zenodo DOI, once minted.
#
#   orcid: add under each author if you have one, as
#     orcid: "https://orcid.org/0000-0000-0000-0000"
#     Deliberately omitted rather than guessed.
#
# ON PUBLICATION, add a preferred-citation block so that citing the code
# resolves to the paper:
#
#   preferred-citation:
#     type: article
#     title: "<the paper's title>"
#     authors: [<the full author list, in byline order>]
#     journal: "JAMA Cardiology"
#     year: 2026
#     doi: "<the article DOI>"
# ---------------------------------------------------------------------------
